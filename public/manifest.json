{
  "manifest_version": 3,
  "name": "QueryFlow",
  "description": "Import, parameterisasi, batch execution SQL, dan ekspor hasil SQL Lab ke Excel.",
  "version": "0.3.6",
  "permissions": ["storage", "tabs", "sidePanel", "scripting", "clipboardWrite", "downloads"],
  "host_permissions": ["https://git.bps.go.id/*", "https://fasih-dashboard.bps.go.id/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/queryflow-active-16.png",
    "32": "icons/queryflow-active-32.png",
    "48": "icons/queryflow-active-48.png",
    "128": "icons/queryflow-active-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://git.bps.go.id/*", "https://fasih-dashboard.bps.go.id/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Buka QueryFlow",
    "default_icon": {
      "16": "icons/queryflow-idle-16.png",
      "32": "icons/queryflow-idle-32.png"
    }
  }
}
